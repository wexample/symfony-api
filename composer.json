{
  "name": "wexample/symfony-api",
  "description": "A simple syntax to expose API in Symfony",
  "type": "library",
  "license": "MIT",
  "version": "8.0.2",
  "keywords": [
    "symfony-ux"
  ],
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyApi\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/php-date": ">=2.0.0",
    "wexample/symfony-testing": ">=5.0.0",
    "wexample/symfony-helpers": ">=13.0.0",
    "wexample/symfony-security": ">=2.0.0",
    "wexample/symfony-loader": ">=18.0.0",
    "wexample/symfony-forms": ">=10.0.0",
    "wexample/symfony-content": ">=4.0.0",
    "doctrine/orm": "^3.0",
    "symfony/security-bundle": "^7.4",
    "symfony/validator": "^7.4",
    "symfony/rate-limiter": "^7.4"
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyApi\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "symfony/browser-kit": "^7.4",
    "symfony/monolog-bundle": "^3.10",
    "nelmio/api-doc-bundle": "^5.12",
    "opis/json-schema": "^2.6"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "scripts": {
    "post-install-cmd": [
      "php bin/console api:check-node-install"
    ],
    "post-update-cmd": [
      "php bin/console api:check-node-install"
    ]
  },
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  },
  "suggest": {
    "symfony/monolog-bundle": "Writes the machine token journal to its own channel, machine_security, and masks tokens in every log",
    "nelmio/api-doc-bundle": "Generates the OpenAPI documents of the API, one per version, through this package's route describer"
  }
}