{
  "name": "wexample/symfony-api",
  "description": "A simple syntax to expose API in Symfony",
  "type": "library",
  "license": "MIT",
  "version": "4.0.1",
  "keywords": [
    "symfony-ux"
  ],
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyApi\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/php-date": ">=1.0.2",
    "wexample/symfony-testing": ">=1.0.86",
    "wexample/symfony-helpers": ">=7.0.0",
    "wexample/symfony-loader": ">=5.0.0",
    "wexample/symfony-forms": ">=3.0.0",
    "wexample/symfony-content": ">=2.0.0"
  },
  "scripts": {
    "post-install-cmd": [
      "php bin/console api:check-node-install"
    ],
    "post-update-cmd": [
      "php bin/console api:check-node-install"
    ]
  },
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
