{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- Two columns per operation, its tables beside its code: the room of a
    wide screen, which the reading measure halves too narrowly. -#}
{%- set page_body_mode = 'large' -%}

{#- The api's OpenAPI document drawn: one section per operation, what it
    takes and answers on one side, a call and its answer on the other. A
    preview shows the paths the application chose, nothing else. -#}

{#- The version of the document, beside the page's name. -#}
{%- block header_title_aside -%}
    {%- if info.version|default(null) -%}
        {{ marker('neutral', info.version, { compact: true }) }}
    {%- endif -%}
{%- endblock -%}

{#- An operation's verb: a category, not a state — no glyph —, in the
    colour every api documentation gives it. -#}
{%- macro method(method) -%}
    {%- set tones = { GET: 'cat-blue-jeans', POST: 'cat-grass', PUT: 'cat-sunflower', PATCH: 'cat-sunflower', DELETE: 'cat-bittersweet' } -%}
    {{ marker(tones[method] ?? 'neutral', method, { compact: true }) }}
{%- endmacro -%}

{%- block page_body -%}
    {%- import _self as api -%}
    {%- set host = app.request.schemeAndHttpHost -%}
    {%- if info.description|default(null) %}<p class="lead">{{ info.description }}</p>{% endif %}
    {%- if preview -%}
        {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/banner', { type: 'info', message: '@page::preview' | trans }) }}
    {%- endif -%}

    {%- if not documented %}
        <p class="empty">{{ '@page::undocumented' | trans }}</p>
    {%- endif %}

    <div class="doc">
        {%- for group, operations in groups %}
            <h2>{{ group|first|upper ~ group|slice(1) }}</h2>
            {%- for operation in operations %}
                {%- set curl = 'curl -X ' ~ operation.method ~ " '" ~ host ~ operation.path ~ "'"
                    ~ (operation.security is not empty ? " \\\n  -H 'Authorization: Bearer $TOKEN'" : '')
                    ~ (operation.body ? " \\\n  -H 'Content-Type: application/json' \\\n  -d '" ~ operation.body.example ~ "'" : '') -%}
                {%- set success = operation.responses | filter(response => response.example) | first -%}
                <section class="doc-section" id="{{ operation.id }}">
                    <div class="doc-section--description">
                        <h3 class="cluster">
                            {{- api.method(operation.method) -}}
                            <code>{{ operation.path }}</code>
                            {%- if operation.deprecated %}{{ marker('warning', '@page::deprecated' | trans, { compact: true }) }}{% endif -%}
                        </h3>
                        {%- if operation.summary %}<p><strong>{{ operation.summary }}</strong></p>{% endif %}
                        {%- if operation.description %}<p>{{ operation.description | nl2br }}</p>{% endif %}
                        {%- if operation.security is not empty %}<p class="text-secondary">{{ '@page::secured' | trans }} <code>{{ operation.security | join(', ') }}</code></p>{% endif %}

                        {%- if operation.parameters is not empty %}
                            <h4>{{ '@page::section_parameters' | trans }}</h4>
                            {{ data_table([
                                { key: 'name', label: '@page::column.name' | trans, cell: 'code' },
                                { key: 'type', label: '@page::column.type' | trans, secondary: true },
                                { key: 'required', label: '', cell: 'status' },
                                { key: 'description', label: '@page::column.description' | trans },
                            ], operation.parameters | map(parameter => {
                                name: parameter.name,
                                type: parameter.in ~ ' · ' ~ parameter.type,
                                required: parameter.required ? { type: 'neutral', label: '@page::required' | trans } : null,
                                description: parameter.description,
                            }), { fill: true, scroll: true }) }}
                        {%- endif %}

                        {%- if operation.body and operation.body.fields is not empty %}
                            <h4>{{ '@page::section_body' | trans }}</h4>
                            {{ data_table([
                                { key: 'name', label: '@page::column.name' | trans, cell: 'code' },
                                { key: 'type', label: '@page::column.type' | trans, secondary: true },
                                { key: 'required', label: '', cell: 'status' },
                                { key: 'description', label: '@page::column.description' | trans },
                            ], operation.body.fields | map(field => {
                                name: field.name,
                                type: field.type,
                                required: field.required ? { type: 'neutral', label: '@page::required' | trans } : null,
                                description: field.description,
                            }), { fill: true, scroll: true }) }}
                        {%- endif %}

                        <h4>{{ '@page::section_responses' | trans }}</h4>
                        {{ data_table([
                            { key: 'code', label: '@page::column.code' | trans, cell: 'code', width: 'xs' },
                            { key: 'description', label: '@page::column.description' | trans },
                        ], operation.responses | map(response => {
                            code: response.code ~ '',
                            description: response.description,
                        }), { fill: true, scroll: true }) }}
                    </div>
                    <div class="doc-section--code stack--vertical">
                        {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', { lang: 'bash', code: curl }) }}
                        {%- if success %}
                            {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', { lang: 'json', code: success.example }) }}
                        {%- endif %}
                    </div>
                </section>
            {%- endfor %}
        {%- endfor %}

        {%- for section in sections %}
            {{ include(section.template, { section: section.context }) }}
        {%- endfor %}
    </div>
{%- endblock -%}
